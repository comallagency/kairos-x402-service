# --- x402 / paiement ---------------------------------------------------
X402_PAY_TO=0x0000000000000000000000000000000000000000
X402_NETWORK=eip155:84532
# eip155:8453 = Base mainnet, eip155:84532 = Base Sepolia (tests)

# --- CDP (facilitateur) --------------------------------------------------
# Optionnels : sans eux, create_facilitator_config() utilise le facilitateur
# CDP public non authentifie (suffisant pour tester le flux de paiement).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- OpenRouter (compte DEDIE, jamais celui de MyHermes) -----------------
OPENROUTER_API_KEY=

# --- Admin dashboard -------------------------------------------------------
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASS=changeme

# --- Premier appel gratuit par wallet ---------------------------------------
# false = desactive (defaut). Le premier paiement d'un nouveau wallet est
# aussi ce qui declenche l'indexation Bazaar CDP et le seul revenu produit par
# les sondes automatiques - ne pas l'offrir tant que l'indexation n'est pas
# confirmee. Repasser a true une fois le premier reglement encaisse. Voir
# BRIEF-CORRECTIONS.md.
FREE_FIRST_CALL=false

# --- Chaine (chain_payments.py, cron horaire) -----------------------------
# Adresses connues comme "mecaniques" (sondes/indexeurs) issues du research
# marche du 05/09/2026, separees par des virgules. Vide = aucun tag applique.
MECHANICAL_WALLETS=

# --- Mail quotidien (send_daily_report.py, cron 1x/jour) -------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
REPORT_EMAIL_TO=

# --- Divers ---------------------------------------------------------------
DATA_DIR=./data
BASE_URL=http://localhost:8000
