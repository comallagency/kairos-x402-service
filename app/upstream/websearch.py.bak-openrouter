import re
from typing import Any

from app import config
from app.upstream.openrouter import chat_completion_with_fallback

# One completion call with the "web" plugin (engine=parallel, mode=turbo) returns
# up to max_results annotations (url_citation) with a raw scraped page extract -
# NOT pre-cleaned as originally assumed: real pages come back full of nav menus
# ("Home / Menu / Photos / Open Times"), repeated address/contact blocks, and
# stray newlines (found 2026-09-05, see BRIEF-CORRECTIONS.md). _clean_extract()
# below does the cleaning our own description promises ("a cleaned page extract").
# Cost is flat per call (~$0.001) regardless of max_results - verified against
# the real API on 2026-09-05 (usage.cost stayed 0.001 at max_results=7).
# max_tokens is kept tiny: we only need the annotations, not the generated prose.

_MAX_EXTRACT_CHARS = 500
_BOILERPLATE_LINE_MAX_WORDS = 4


def _clean_extract(raw: str | None) -> str | None:
    """Strip nav-menu-style lines and verbatim-repeated lines from a raw scraped
    page extract, then flatten to one paragraph capped at ~500 chars.

    Heuristic, not site-specific: a line with no sentence-ending punctuation and
    only a handful of words reads as a UI label ("Home", "Open Times") rather
    than prose, so it's dropped; exact-duplicate lines (the same address/phone
    block repeated across a page) are dropped after the first occurrence.
    """
    if not raw:
        return raw

    seen: set[str] = set()
    kept: list[str] = []
    for line in raw.splitlines():
        bare = re.sub(r"^[*\-•]\s*", "", line.strip())
        if not bare:
            continue
        looks_like_sentence = bool(re.search(r"[.!?]\s*$", bare))
        if len(bare.split()) <= _BOILERPLATE_LINE_MAX_WORDS and not looks_like_sentence:
            continue
        key = bare.lower()
        if key in seen:
            continue
        seen.add(key)
        kept.append(bare)

    text = re.sub(r"\s+", " ", " ".join(kept)).strip()

    if len(text) > _MAX_EXTRACT_CHARS:
        cut = text[:_MAX_EXTRACT_CHARS]
        last_space = cut.rfind(" ")
        if last_space > 0:
            cut = cut[:last_space]
        text = cut.rstrip(",;:- ") + "..."

    return text or None


async def run_web_search(query: str, max_results: int = 5) -> tuple[list[dict[str, Any]], str | None]:
    max_results = max(1, min(max_results, 10))
    data, _ = await chat_completion_with_fallback(
        [{"role": "user", "content": query}],
        config.OPENROUTER_TRANSLATE_MODELS,
        config.OPENROUTER_LAST_RESORT_MODEL,
        extra_body={
            "plugins": [
                {"id": "web", "engine": "parallel", "mode": "turbo", "max_results": max_results}
            ]
        },
        max_tokens=16,
    )
    message = data["choices"][0]["message"]
    model_served = data.get("model")

    results = []
    for ann in message.get("annotations") or []:
        uc = ann.get("url_citation") or {}
        url = uc.get("url")
        if not url:
            continue
        title = (uc.get("title") or "").strip() or None
        results.append(
            {
                "title": title,
                "url": url,
                "extract": _clean_extract(uc.get("content")),
                "date": uc.get("date"),
            }
        )
    return results, model_served
